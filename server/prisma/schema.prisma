generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model favoritevocabulary {
  userid       String
  vocabularyid String
  note         String?
  createdat    DateTime   @default(now()) @db.Timestamp(6)
  user         user       @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vocabulary   vocabulary @relation(fields: [vocabularyid], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userid, vocabularyid])
}

model flashcardreview {
  id                 String           @id
  flashcardsessionid String
  vocabularyid       String
  result             String
  reviewedat         DateTime         @default(now()) @db.Timestamp(6)
  flashcardsession   flashcardsession @relation(fields: [flashcardsessionid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vocabulary         vocabulary       @relation(fields: [vocabularyid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model flashcardsession {
  id              String            @id
  userid          String
  topicid         String
  status          String            @default("IN_PROGRESS")
  startedat       DateTime          @default(now()) @db.Timestamp(6)
  completedat     DateTime?         @db.Timestamp(6)
  totalcards      Int               @default(0)
  knowncount      Int               @default(0)
  reviewcount     Int               @default(0)
  flashcardreview flashcardreview[]
  topic           topic             @relation(fields: [topicid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user            user              @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model learninghistory {
  id                String           @id
  userid            String
  activitytype      String
  topicid           String?
  practicesessionid String?
  score             Int?
  totalquestions    Int?
  correctanswers    Int?
  durationseconds   Int?
  details           Json?
  completedat       DateTime         @default(now()) @db.Timestamp(6)
  practicesession   practicesession? @relation(fields: [practicesessionid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topic             topic?           @relation(fields: [topicid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user              user             @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model notificationlog {
  id         String    @id
  userid     String
  reminderid String?
  title      String
  body       String?
  status     String    @default("QUEUED")
  sentat     DateTime? @db.Timestamp(6)
  readat     DateTime? @db.Timestamp(6)
  createdat  DateTime  @default(now()) @db.Timestamp(6)
  reminder   reminder? @relation(fields: [reminderid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       user      @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model practiceanswer {
  id                 String           @id
  practicequestionid String
  answer             Json
  iscorrect          Boolean
  answeredat         DateTime         @default(now()) @db.Timestamp(6)
  practicequestion   practicequestion @relation(fields: [practicequestionid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model practicequestion {
  id                String           @id
  practicesessionid String
  questiontype      String
  prompt            String
  choices           Json?
  correctanswer     Json
  explanation       String?
  displayorder      Int              @default(0)
  practiceanswer    practiceanswer[]
  practicesession   practicesession  @relation(fields: [practicesessionid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model practicesession {
  id               String             @id
  userid           String
  topicid          String?
  type             String
  status           String             @default("IN_PROGRESS")
  startedat        DateTime           @default(now()) @db.Timestamp(6)
  completedat      DateTime?          @db.Timestamp(6)
  score            Int?
  totalquestions   Int                @default(0)
  correctanswers   Int                @default(0)
  learninghistory  learninghistory[]
  practicequestion practicequestion[]
  topic            topic?             @relation(fields: [topicid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             user               @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model reminder {
  id              String            @id
  userid          String
  title           String
  message         String?
  timeofday       String            @db.VarChar
  daysofweek      Json
  timezone        String            @db.VarChar
  channel         String            @default("PUSH")
  isenabled       Boolean           @default(true)
  createdat       DateTime          @default(now()) @db.Timestamp(6)
  updatedat       DateTime          @db.Timestamp(6)
  notificationlog notificationlog[]
  user            user              @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model topic {
  id               String             @id
  title            String
  description      String?
  level            String             @default("BEGINNER")
  displayorder     Int                @default(0)
  isactive         Boolean            @default(true)
  createdat        DateTime           @default(now()) @db.Timestamp(6)
  updatedat        DateTime           @db.Timestamp(6)
  flashcardsession flashcardsession[]
  learninghistory  learninghistory[]
  practicesession  practicesession[]
  vocabulary       vocabulary[]
}

model user {
  id                     String                   @id
  firebaseuid            String?
  email                  String
  passwordhash           String?
  fullname               String
  avatarurl              String?
  isactive               Boolean                  @default(true)
  createdat              DateTime                 @default(now()) @db.Timestamp(6)
  updatedat              DateTime                 @db.Timestamp(6)
  favoritevocabulary     favoritevocabulary[]
  flashcardsession       flashcardsession[]
  learninghistory        learninghistory[]
  notificationlog        notificationlog[]
  practicesession        practicesession[]
  reminder               reminder[]
  userdailygoal          userdailygoal[]
  userlearningplan       userlearningplan[]
  usersetting            usersetting[]
  uservocabularyprogress uservocabularyprogress[]
}

model userdailygoal {
  id                   String    @id
  userid               String
  targetwordsperday    Int       @default(10)
  targetpracticeperday Int       @default(1)
  targetminutesperday  Int       @default(15)
  currentstreak        Int       @default(0)
  beststreak           Int       @default(0)
  lastlearneddate      DateTime? @db.Timestamp(6)
  createdat            DateTime  @default(now()) @db.Timestamp(6)
  updatedat            DateTime  @db.Timestamp(6)
  user                 user      @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model userlearningplan {
  id        String   @id
  userid    String
  level     String
  iscurrent Boolean  @default(true)
  startedat DateTime @default(now()) @db.Timestamp(6)
  updatedat DateTime @db.Timestamp(6)
  user      user     @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model usersetting {
  id                   String   @id
  userid               String
  thememode            String   @default("SYSTEM")
  colorstyle           String   @default("OCEAN")
  applanguage          String   @default("en") @db.VarChar
  notificationsenabled Boolean  @default(true)
  pushnotifications    Boolean  @default(true)
  emailnotifications   Boolean  @default(false)
  remindertime         String?  @db.VarChar
  timezone             String?  @db.VarChar
  createdat            DateTime @default(now()) @db.Timestamp(6)
  updatedat            DateTime @db.Timestamp(6)
  user                 user     @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model uservocabularyprogress {
  userid         String
  vocabularyid   String
  exposurecount  Int        @default(0)
  correctcount   Int        @default(0)
  masteryscore   Float      @default(0)
  lastreviewedat DateTime?  @db.Timestamp(6)
  nextreviewat   DateTime?  @db.Timestamp(6)
  updatedat      DateTime   @db.Timestamp(6)
  user           user       @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vocabulary     vocabulary @relation(fields: [vocabularyid], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userid, vocabularyid])
}

model vocabulary {
  id                     String                   @id
  topicid                String
  word                   String
  meaning                String
  pronunciationtext      String?
  pronunciationaudio     String?
  partofspeech           String?
  difficulty             Int                      @default(1)
  createdat              DateTime                 @default(now()) @db.Timestamp(6)
  updatedat              DateTime                 @db.Timestamp(6)
  favoritevocabulary     favoritevocabulary[]
  flashcardreview        flashcardreview[]
  uservocabularyprogress uservocabularyprogress[]
  topic                  topic                    @relation(fields: [topicid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vocabularyexample      vocabularyexample[]
}

model vocabularyexample {
  id           String     @id
  vocabularyid String
  sentence     String
  translation  String?
  audiourl     String?
  createdat    DateTime   @default(now()) @db.Timestamp(6)
  vocabulary   vocabulary @relation(fields: [vocabularyid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
