generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model FavoriteVocabulary {
  userId       String
  vocabularyId String
  note         String?
  createdAt    DateTime   @default(now())
  User         User       @relation(fields: [userId], references: [id])
  Vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id])

  @@id([userId, vocabularyId])
  @@index([vocabularyId])
}

model FlashcardReview {
  id                 String           @id @default(uuid())
  flashcardSessionId String
  vocabularyId       String
  result             ReviewResult
  reviewedAt         DateTime         @default(now())
  FlashcardSession   FlashcardSession @relation(fields: [flashcardSessionId], references: [id])
  Vocabulary         Vocabulary       @relation(fields: [vocabularyId], references: [id])

  @@index([flashcardSessionId])
}

model FlashcardSession {
  id              String            @id @default(uuid())
  userId          String
  topicId         String
  totalCards      Int               @default(0)
  knownCount      Int               @default(0)
  reviewCount     Int               @default(0)
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  FlashcardReview FlashcardReview[]
  Topic           Topic             @relation(fields: [topicId], references: [id])
  User            User              @relation(fields: [userId], references: [id])

  @@index([topicId])
  @@index([userId])
}

model LearningHistory {
  id                String           @id @default(uuid())
  userId            String
  activityType      ActivityType
  topicId           String?
  practiceSessionId String?
  score             Int?
  totalQuestions    Int?
  correctAnswers    Int?
  durationSeconds   Int?
  details           Json?
  completedAt       DateTime         @default(now())
  PracticeSession   PracticeSession? @relation(fields: [practiceSessionId], references: [id])
  Topic             Topic?           @relation(fields: [topicId], references: [id])
  User              User             @relation(fields: [userId], references: [id])

  @@index([userId, completedAt(sort: Desc)])
}

model NotificationLog {
  id         String    @id @default(uuid())
  userId     String
  reminderId String?
  title      String
  body       String?
  sentAt     DateTime?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  Reminder   Reminder? @relation(fields: [reminderId], references: [id])
  User       User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PracticeAnswer {
  id                 String           @id @default(uuid())
  practiceQuestionId String
  answer             Json
  isCorrect          Boolean
  answeredAt         DateTime         @default(now())
  PracticeQuestion   PracticeQuestion @relation(fields: [practiceQuestionId], references: [id])

  @@index([practiceQuestionId])
}

model PracticeQuestion {
  id                String           @id @default(uuid())
  practiceSessionId String
  questionType      QuestionType
  prompt            String
  choices           Json?
  correctAnswer     Json
  explanation       String?
  displayOrder      Int              @default(0)
  PracticeAnswer    PracticeAnswer[]
  PracticeSession   PracticeSession  @relation(fields: [practiceSessionId], references: [id])

  @@index([practiceSessionId])
}

model PracticeSession {
  id               String             @id @default(uuid())
  userId           String
  topicId          String?
  type             PracticeType
  score            Int?
  totalQuestions   Int                @default(0)
  correctAnswers   Int                @default(0)
  startedAt        DateTime           @default(now())
  completedAt      DateTime?
  LearningHistory  LearningHistory[]
  PracticeQuestion PracticeQuestion[]
  Topic            Topic?             @relation(fields: [topicId], references: [id])
  User             User               @relation(fields: [userId], references: [id])

  @@index([topicId])
  @@index([userId])
}

model Reminder {
  id              String              @id @default(uuid())
  userId          String
  title           String
  message         String?
  timeOfDay       String
  daysOfWeek      Json
  timezone        String
  channel         NotificationChannel @default(PUSH)
  isEnabled       Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime
  NotificationLog NotificationLog[]
  User            User                @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Topic {
  id               String             @id @default(uuid())
  title            String
  description      String?
  icon             String?
  level            Level              @default(BEGINNER)
  displayOrder     Int                @default(0)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  FlashcardSession FlashcardSession[]
  LearningHistory  LearningHistory[]
  PracticeSession  PracticeSession[]
  Vocabulary       Vocabulary[]
  ClozeQuestion    ClozeQuestion[]
}

model User {
  id                     String                   @id @default(uuid())
  email                  String                   @unique
  passwordHash           String?
  resetPasswordOtpHash   String?
  resetPasswordExpiresAt DateTime?
  fullName               String
  avatarUrl              String?
  role                   UserRoles                @default(USER)
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now())
  provider               AuthProvider             @default(local)
  FavoriteVocabulary     FavoriteVocabulary[]
  FlashcardSession       FlashcardSession[]
  LearningHistory        LearningHistory[]
  NotificationLog        NotificationLog[]
  PracticeSession        PracticeSession[]
  Reminder               Reminder[]
  UserDailyGoal          UserDailyGoal[]
  UserLearningPlan       UserLearningPlan[]
  UserSetting            UserSetting[]
  UserVocabularyProgress UserVocabularyProgress[]
  DailyMission           DailyMission[]
}

model UserDailyGoal {
  id                   String    @id @default(uuid())
  userId               String    @unique
  targetWordsPerDay    Int       @default(10)
  targetPracticePerDay Int       @default(1)
  targetMinutesPerDay  Int       @default(15)
  currentStreak        Int       @default(0)
  bestStreak           Int       @default(0)
  lastLearnedDate      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime
  User                 User      @relation(fields: [userId], references: [id])
}

model UserLearningPlan {
  id        String   @id @default(uuid())
  userId    String
  level     Level
  isCurrent Boolean  @default(true)
  startedAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
}

model UserSetting {
  id                   String   @id @default(uuid())
  userId               String
  appLanguage          String   @default("en")
  notificationsEnabled Boolean  @default(true)
  pushNotifications    Boolean  @default(true)
  emailNotifications   Boolean  @default(false)
  reminderTime         String?
  timezone             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  User                 User     @relation(fields: [userId], references: [id])
}

model UserVocabularyProgress {
  userId         String
  vocabularyId   String
  exposureCount  Int                  @default(0)
  status         UserVocabularyStatus @default(LEARNING)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  updatedAt      DateTime
  User           User                 @relation(fields: [userId], references: [id])
  Vocabulary     Vocabulary           @relation(fields: [vocabularyId], references: [id])

  @@id([userId, vocabularyId])
  @@index([nextReviewAt])
  @@index([vocabularyId])
}

model Vocabulary {
  id                     String                   @id @default(uuid())
  topicId                String
  word                   String
  meaning                String
  pronunciationText      String?
  pronunciationAudio     String?
  partOfSpeech           PartOfSpeech?
  difficulty             Int                      @default(1)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  FavoriteVocabulary     FavoriteVocabulary[]
  FlashcardReview        FlashcardReview[]
  UserVocabularyProgress UserVocabularyProgress[]
  Topic                  Topic                    @relation(fields: [topicId], references: [id])
  VocabularyExample      VocabularyExample[]
  DailyTaskCompletion    DailyTaskCompletion[]

  @@index([topicId])
  @@index([word])
}

model VocabularyExample {
  id           String     @id @default(uuid())
  vocabularyId String
  sentence     String
  translation  String?
  audioUrl     String?
  createdAt    DateTime   @default(now())
  Vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id])

  @@index([vocabularyId])
}

model ClozeQuestion {
  id        Int      @id @default(autoincrement())
  topicId   String
  sentence  String
  createdAt DateTime @default(now())

  Topic        Topic          @relation(fields: [topicId], references: [id])
  ClozeOptions ClozeOptions[]
}

model ClozeOptions {
  id         Int
  questionId Int
  optionText String
  isCorrect  Boolean
  createdAt  DateTime @default(now())
  blankIndex Int

  ClozeQuestion ClozeQuestion @relation(fields: [questionId], references: [id])

  @@id([questionId, id])
}

model DailyMission {
  id        String        @id @default(uuid())
  userId    String
  date      DateTime
  status    MissionStatus @default(IN_PROGRESS)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  User      User          @relation(fields: [userId], references: [id])
  DailyTask DailyTask[]

  @@unique([userId, date])
  @@index([userId])
}

model DailyTask {
  id                  String                @id @default(uuid())
  dailyMissionId      String
  taskType            DailyTaskType
  targetCount         Int                   @default(5)
  completedCount      Int                   @default(0)
  status              TaskStatus            @default(IN_PROGRESS)
  vocabularyIds       Json
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  DailyMission        DailyMission          @relation(fields: [dailyMissionId], references: [id])
  DailyTaskCompletion DailyTaskCompletion[]

  @@index([dailyMissionId])
}

model DailyTaskCompletion {
  dailyTaskId  String
  vocabularyId String
  completedAt  DateTime   @default(now())
  DailyTask    DailyTask  @relation(fields: [dailyTaskId], references: [id])
  Vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id])

  @@id([dailyTaskId, vocabularyId])
}

model Toeic {
  id                    String                 @id @default(uuid())
  title                 String
  level                 Level                  @default(BEGINNER)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  readingPart5Questions ReadingPart5Question[]
}

model ReadingPart5Question {
  id        String   @id @default(uuid())
  toeicId   String
  question  String
  options   String[]
  answer    Int
  createdAt DateTime @default(now())

  Toeic Toeic @relation(fields: [toeicId], references: [id])
}

enum ToeicLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum UserRoles {
  USER
  ADMIN
}

enum UserVocabularyStatus {
  LEARNING
  MASTERED
}

enum DailyTaskType {
  VOCABULARY_LEARN
  FLASHCARD_LEARN
}

enum MissionStatus {
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  IN_PROGRESS
  COMPLETED
}

enum ActivityType {
  FLASHCARD_REVIEW
  PRACTICE_TEST
  TOPIC_COMPLETION
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
}

enum PracticeType {
  VOCABULARY
  GRAMMAR
  LISTENING
  READING
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  TRUE_FALSE
  MATCHING
  FLASHCARD
}

enum ReviewResult {
  AGAIN
  HARD
  GOOD
  EASY
}

enum AuthProvider {
  local
  google
}
